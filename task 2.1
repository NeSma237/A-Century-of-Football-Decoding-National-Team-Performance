    "# Z-score\n",
    "mean_margin = results['goal_margin'].mean()\n",
    "std_margin = results['goal_margin'].std()\n",
    "\n",
    "results['goal_margin_zscore'] = (results['goal_margin'] - mean_margin) / std_margin\n",
    "\n",
    "print(\n",
    "    f\"Mean: {mean_margin:.3f}, \"\n",
    "    f\"Standard deviation: {std_margin:.3f}\"\n",
    ")\n",
    "\n",
    "# Select matches with extreme goal margins (|Z-score| > 3)\n",
    "outliers_z = results[results['goal_margin_zscore'].abs() > 3]\n",
    "print(f\"Number of extreme matches: {len(outliers_z)}\")\n",
    "print(\n",
    "    f\"Percentage of all matches: \"\n",
    "    f\"{len(outliers_z) / len(results) * 100:.2f}%\"\n",
    ")\n",
    "\n",
    "print(outliers_z.sort_values('goal_margin_zscore', ascending=False)[['date', 'home_team', 'away_team', 'goal_margin', 'goal_margin_zscore']].head(10))"
   ]
