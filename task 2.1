    "efficiency_fifa = team_matches_fifa.groupby('team').agg(\n",
    "    total_points=('points', 'sum'),\n",
    "    total_goals=('goals_for', 'sum'),\n",
    "    matches_played=('team', 'size')\n",
    ")\n",
    "\n",
    "efficiency_fifa['points_per_match'] = efficiency_fifa['total_points'] / efficiency_fifa['matches_played']\n",
    "efficiency_fifa['goals_per_match'] = efficiency_fifa['total_goals'] / efficiency_fifa['matches_played']\n",
    "\n",
    "MIN_MATCHES = 100\n",
    "qualified_fifa = efficiency_fifa[efficiency_fifa['matches_played'] >= MIN_MATCHES]\n",
    "\n",
    "top_by_points_fifa = qualified_fifa.sort_values('points_per_match', ascending=False).head(10)\n",
    "print(top_by_points_fifa)"
   ]
