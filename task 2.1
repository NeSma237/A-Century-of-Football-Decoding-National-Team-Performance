    "# Calculate IQR-based upper limit for detecting extreme goal margins\n",
    "Q1 = results['goal_margin'].quantile(0.25)\n",
    "Q3 = results['goal_margin'].quantile(0.75)\n",
    "\n",
    "IQR = Q3 - Q1\n",
    "\n",
    "upper_bound = Q3 + 1.5 * IQR\n",
    "\n",
    "print(f\"Upper bound (IQR method): {upper_bound}\")\n",
    "\n",
    "\n",
    "# Extract matches with unusually large goal margins\n",
    "outliers = results[\n",
    "    results['goal_margin'] > upper_bound\n",
    "]\n",
    "\n",
    "print(f\"Number of outlier matches: {len(outliers)}\")\n",
    "print(\n",
    "    f\"Percentage of all matches: \"\n",
    "    f\"{len(outliers) / len(results) * 100:.2f}%\"\n",
    ")"
   ]
