   "source": [
    "# Extract the match year\n",
    "results['year'] = results['date'].dt.year\n",
    "\n",
    "# Create a decade feature for long-term trend analysis\n",
    "results['decade'] = (results['year'] // 10) * 10\n",
    "\n",
    "# Calculate the total number of goals scored in each match\n",
    "results['total_goals'] = results['home_score'] + results['away_score']\n",
    "\n",
    "# Calculate the absolute goal difference between the two teams\n",
    "results['goal_margin'] = (results['home_score'] - results['away_score']).abs()\n",
    "\n",
    "# Determine the match outcome from the home team's perspective\n",
    "def get_result(row):\n",
    "    if row['home_score'] > row['away_score']:\n",
    "        return 'home_win'\n",
    "    elif row['home_score'] < row['away_score']:\n",
    "        return 'away_win'\n",
    "    else:\n",
    "        return 'draw'\n",
    "\n",
    "# Apply the function to create the outcome column\n",
    "results['outcome'] = results.apply(get_result, axis=1)\n",
    "\n",
    "# Preview the newly engineered features\n",
    "print(results[['date', 'home_team', 'away_team', 'home_score', 'away_score',\n",
    "               'decade', 'total_goals', 'goal_margin', 'outcome']].head())\n",
    "\n",
    "# Display the distribution of match outcomes\n",
    "print(results['outcome'].value_counts())"
   ]
